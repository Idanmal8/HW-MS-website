# Canonical origin used for canonical URLs, sitemap.xml, robots.txt and OG images.
NUXT_PUBLIC_SITE_URL=https://hard-will.vercel.app

# Google Search Console "HTML tag" verification (just the content="..." value).
# Not needed if you verify the domain with a DNS TXT record instead.
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification (msvalidate.01 content value). Optional.
NUXT_PUBLIC_BING_SITE_VERIFICATION=

# Hard Will API, read at build time for the supporters list. Empty: no list.
NUXT_API_URL=
